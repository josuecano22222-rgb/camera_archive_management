{
 "doctype": "DocType",
 "name": "CAM Geo Settings",
 "module": "Camera Archive Management",
 "engine": "InnoDB",
 "fields": [
  {
   "fieldname": "layout_tab_1",
   "fieldtype": "Tab Break",
   "label": "Search & Geocoding"
  },
  {
   "fieldname": "layout_section_1_1",
   "fieldtype": "Section Break",
   "label": "Search precision"
  },
  {
   "fieldname": "active_dataset",
   "fieldtype": "Link",
   "label": "Active Dataset",
   "options": "Geo Dataset"
  },
  {
   "fieldname": "default_search_radius_m",
   "fieldtype": "Int",
   "label": "Default Search Radius M",
   "default": "5000"
  },
  {
   "fieldname": "ambiguity_threshold_m",
   "fieldtype": "Int",
   "label": "Ambiguity Threshold M",
   "default": "250"
  },
  {
   "fieldname": "layout_section_1_2",
   "fieldtype": "Section Break",
   "label": "Online geocoder"
  },
  {
   "fieldname": "enable_online_geocoder",
   "fieldtype": "Check",
   "label": "Enable Online Geocoder",
   "default": "0"
  },
  {
   "fieldname": "online_provider",
   "fieldtype": "Select",
   "label": "Online Provider",
   "options": "Disabled\nNominatim (OpenStreetMap)",
   "default": "Disabled"
  },
  {
   "fieldname": "online_user_agent",
   "fieldtype": "Data",
   "label": "Online User Agent",
   "description": "Required contact identifier when explicitly enabling Nominatim."
  },
  {
   "fieldname": "online_rate_limit_per_min",
   "fieldtype": "Int",
   "label": "Online Rate Limit Per Min",
   "default": "30"
  },
  {
   "fieldname": "online_cache_days",
   "fieldtype": "Int",
   "label": "Online Cache Days",
   "default": "30"
  },
  {
   "fieldname": "allow_online_setup",
   "fieldtype": "Check",
   "label": "Allow Online Setup",
   "default": "0"
  },
  {
   "fieldname": "layout_tab_2",
   "fieldtype": "Tab Break",
   "label": "Map Tile Operations"
  },
  {
   "fieldname": "layout_section_2_1",
   "fieldtype": "Section Break",
   "label": "Fetch controls"
  },
  {
   "fieldname": "enable_online_tile_fetch",
   "fieldtype": "Check",
   "label": "Enable Online Tile Fetch",
   "default": "0",
   "description": "Explicit opt-in. Fetching also requires Siraj Geo Settings > Allow server to fetch from provider. Review provider terms and attribution before enabling."
  },
  {
   "fieldname": "allow_tile_cache_write",
   "fieldtype": "Check",
   "label": "Allow Shared Tile Cache Writes",
   "default": "0",
   "description": "Persist validated provider tiles to the shared private/siraj_tile_cache. Also requires online tile fetching to be enabled."
  },
  {
   "fieldname": "layout_section_2_2",
   "fieldtype": "Section Break",
   "label": "Network timeouts"
  },
  {
   "fieldname": "tile_connect_timeout_seconds",
   "fieldtype": "Int",
   "label": "Tile Connect Timeout Seconds",
   "default": "2"
  },
  {
   "fieldname": "tile_read_timeout_seconds",
   "fieldtype": "Int",
   "label": "Tile Read Timeout Seconds",
   "default": "3"
  },
  {
   "fieldname": "layout_tab_3",
   "fieldtype": "Tab Break",
   "label": "Dataset Provenance"
  },
  {
   "fieldname": "layout_section_3_1",
   "fieldtype": "Section Break",
   "label": "Last import"
  },
  {
   "fieldname": "last_dataset_import",
   "fieldtype": "Datetime",
   "label": "Last Dataset Import",
   "read_only": 1
  }
 ],
