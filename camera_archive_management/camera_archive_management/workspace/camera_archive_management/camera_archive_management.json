 "content": "[{\"id\":\"cam-hdr\",\"type\":\"header\",\"data\":{\"text\":\"<span class=\\\"h4\\\"><b>Camera Archive Management</b></span>\",\"col\":12}},{\"id\":\"cam-desc\",\"type\":\"paragraph\",\"data\":{\"text\":\"Camera inventory, circular photo pins, vehicle movement history, archive integrity, and offline-first geographic lookup. Basemap tiles are read from Siraj’s shared private/siraj_tile_cache; coordinates remain exact decimal strings.\",\"col\":12}},{\"id\":\"cam-overview\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Camera Archive Overview\",\"col\":4}},{\"id\":\"cam-map\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Camera Archive Map\",\"col\":4}},{\"id\":\"cam-camera\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Camera\",\"col\":4}},{\"id\":\"cam-event\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Motion Event\",\"col\":4}},{\"id\":\"cam-vehicle\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"CAM Vehicle\",\"col\":4}},{\"id\":\"cam-asset\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Archive Asset\",\"col\":4}},{\"id\":\"cam-batch\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Archive Ingest Batch\",\"col\":4}},{\"id\":\"cam-reports-hdr\",\"type\":\"header\",\"data\":{\"text\":\"<span class=\\\"h4\\\"><b>Operational &amp; Spatial Reports</b></span>\",\"col\":12}},{\"id\":\"cam-report-0\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Camera Coverage\",\"col\":3}},{\"id\":\"cam-report-1\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Vehicle Movement Timeline\",\"col\":3}},{\"id\":\"cam-report-2\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Archive Integrity\",\"col\":3}},{\"id\":\"cam-report-3\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Geo Location Quality\",\"col\":3}},{\"id\":\"cam-ref-hdr\",\"type\":\"header\",\"data\":{\"text\":\"<span class=\\\"h4\\\"><b>Reference &amp; Configuration</b></span>\",\"col\":12}},{\"id\":\"cam-ref-0\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Camera Area\",\"col\":3}},{\"id\":\"cam-ref-1\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Camera Type\",\"col\":3}},{\"id\":\"cam-ref-2\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Camera Credential\",\"col\":3}},{\"id\":\"cam-ref-3\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Vehicle Type\",\"col\":3}},{\"id\":\"cam-ref-4\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Archive Settings\",\"col\":3}},{\"id\":\"cam-ref-5\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"CAM Geo Settings\",\"col\":3}},{\"id\":\"cam-ref-6\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Geo Dataset\",\"col\":3}},{\"id\":\"cam-ref-7\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Geo Admin Area\",\"col\":3}},{\"id\":\"cam-ref-8\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Geo Boundary\",\"col\":3}},{\"id\":\"cam-ref-9\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Geo Gazetteer Place\",\"col\":3}}]",
